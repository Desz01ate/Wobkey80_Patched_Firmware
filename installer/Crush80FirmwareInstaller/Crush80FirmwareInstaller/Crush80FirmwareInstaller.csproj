<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>Crush80FirmwareInstaller</AssemblyName>
        <RootNamespace>Crush80FirmwareInstaller</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Version>1.0.0</Version>
        <Authors>Wobkey Crush 80 Community</Authors>
        <Description>Configurable USB OTA firmware installer for the Wobkey Crush 80.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Update="firmware-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Include="..\..\..\firmware\v2_patched.bin" Link="firmware\v2_patched.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Include="..\..\..\firmware\firmware_patched.bin" Link="firmware\firmware_patched.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
